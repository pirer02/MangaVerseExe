<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.zixion.mangaverse.controllers.CapitulosController"
      spacing="20" style="-fx-padding: 30; -fx-background-color: transparent;">
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="← Volver" onAction="#volverABiblioteca"
                style="-fx-background-color: #600000; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Label fx:id="mangaTituloLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <ListView fx:id="listaCapitulos" VBox.vgrow="ALWAYS"
              style="-fx-background-color: rgba(255,255,255,0.05); -fx-control-inner-background: #2c3e50; -fx-text-fill: white;"/>
</VBox>