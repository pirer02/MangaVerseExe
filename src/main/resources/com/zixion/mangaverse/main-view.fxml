<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.zixion.mangaverse.MainController" style="-fx-background-color: #ffffff;">

    <AnchorPane fx:id="mainContent" style="-fx-background-color: #f0f0f0;">
        <children>
            <StackPane fx:id="viewContainer" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0" />

            <Button text="☰" layoutX="14.0" layoutY="14.0" onAction="#toggleMenu" style="-fx-font-size: 20; -fx-background-color: transparent; -fx-cursor: hand;"/>
            <Label layoutX="60.0" layoutY="22.0" text="MangaVerse" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        </children>
    </AnchorPane>

    <VBox fx:id="drawerMenu" maxWidth="250" translateX="-250" style="-fx-background-color: #2c3e50; -fx-padding: 50 20 20 20;" StackPane.alignment="CENTER_LEFT">
        <children>
            <HBox alignment="TOP_RIGHT">
                <Button text="✕" onAction="#toggleMenu" style="-fx-text-fill: white; -fx-background-color: transparent; -fx-font-size: 18; -fx-cursor: hand;"/>
            </HBox>
        </children>
    </VBox>

</StackPane>