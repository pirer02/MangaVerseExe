<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.zixion.mangaverse.controllers.MainController" style="-fx-background-color: #2c3e50;">

    <AnchorPane fx:id="mainContent" style="-fx-background-color: #2c3e50;">
        <children>
            <StackPane fx:id="viewContainer" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                       AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0"
                       style="-fx-background-color: transparent;" />

            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0"
                  AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
                  style="-fx-background-color: linear-gradient(to right, #600000, #000000); -fx-padding: 0 20 0 20;">
                <children>
                    <Button text="☰" onAction="#toggleMenu"
                            style="-fx-font-size: 24; -fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"/>
                    <Label text="MangaVerse"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <Pane HBox.hgrow="ALWAYS" />

                    <TextField fx:id="searchBar" promptText="Buscar manga..."
                               style="-fx-background-color: rgba(255, 255, 255, 0.15);
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #bdc3c7;
                                      -fx-background-radius: 20;
                                      -fx-padding: 8 15 8 15;
                                      -fx-min-width: 250;
                                      -fx-border-color: rgba(255, 255, 255, 0.3);
                                      -fx-border-radius: 20;"/>
                </children>
            </HBox>
        </children>
    </AnchorPane>

    <VBox fx:id="drawerMenu" maxWidth="280" translateX="-280" spacing="20"
          style="-fx-background-color: linear-gradient(to bottom, #600000, #000000);
                 -fx-padding: 30 20 20 20;"
          StackPane.alignment="CENTER_LEFT">
        <children>
            <HBox alignment="TOP_RIGHT">
                <Button text="✕" onAction="#toggleMenu"
                        style="-fx-text-fill: white; -fx-background-color: transparent; -fx-font-size: 20; -fx-cursor: hand;"/>
            </HBox>

            <VBox alignment="CENTER" spacing="15" style="-fx-padding: 0 0 30 0;">

                <ImageView fitHeight="120.0" fitWidth="120.0" preserveRatio="true">
                    <image>
                        <Image url="@icons/MV.png" />
                    </image>
                </ImageView>

                <Label text="¡Bienvenido!"
                       style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 5, 0, 0, 1);"/>

                <Label text="Tu portal de manga"
                       style="-fx-text-fill: #bdc3c7; -fx-font-size: 12;"/>
            </VBox>

            <Separator opacity="0.3" />

            <Button text="Inicio" onAction="#abrirInicio"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;" maxWidth="Infinity"/>
            
            <Button text="Biblioteca" onAction="#abrirBiblioteca"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS" />

            <Separator opacity="0.3" />

            <Button text="🗑 Borrar Datos" onAction="#borrarDatos"
                    style="-fx-background-color: transparent; -fx-text-fill: #ff6b6b; -fx-font-size: 14; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-font-weight: bold;"
                    maxWidth="Infinity">
                <tooltip>
                    <Tooltip text="Elimina descargas y biblioteca" />
                </tooltip>
            </Button>
        </children>
    </VBox>

</StackPane>