<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.zixion.mangaverse.controllers.LectorController"
           style="-fx-background-color: #1a1a1a;">

    <VBox alignment="TOP_CENTER" style="-fx-background-color: #1a1a1a;">

        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #000000;">
            <children>
                <Button text="← Volver" onAction="#cerrarLector"
                        style="-fx-background-color: #444; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS" />

                <HBox spacing="10" alignment="CENTER">
                    <Label fx:id="lblProgresoPagina" text="0 / 0" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" />
                    <Slider fx:id="sliderProgreso" prefWidth="250" blockIncrement="1" style="-fx-cursor: hand;" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox spacing="5" alignment="CENTER">
                    <ComboBox fx:id="comboMusica" promptText="♫ Ambiente" prefWidth="150"
                              style="-fx-background-color: #333; -fx-text-fill: white; -fx-font-size: 11; -fx-base: #333;"/>
                    <Button fx:id="btnPlayPause" text="▶" onAction="#toggleMusic"
                            style="-fx-background-color: #333; -fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnAnterior" text="ANTERIOR" onAction="#capituloAnterior"
                            style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 11; -fx-font-weight: bold;"/>

                    <Label fx:id="lblCapitulo" text="Cargando..."
                           style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-min-width: 150; -fx-alignment: CENTER;"/>

                    <Button fx:id="btnSiguiente" text="SIGUIENTE" onAction="#capituloSiguiente"
                            style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 11; -fx-font-weight: bold;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <VBox alignment="CENTER" spacing="2">
                    <HBox spacing="5" alignment="CENTER">
                        <Button text="-" onAction="#disminuirZoom"
                                style="-fx-background-color: #333; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 25; -fx-cursor: hand;"/>

                        <ToggleButton fx:id="btnLupa" text="🔍" onAction="#toggleLupa"
                                      style="-fx-background-color: #444; -fx-text-fill: white; -fx-cursor: hand; -fx-base: #444;"/>

                        <Button text="+" onAction="#aumentarZoom"
                                style="-fx-background-color: #333; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 25; -fx-cursor: hand;"/>
                    </HBox>

                    <HBox spacing="5" alignment="CENTER">
                        <Label text="Tamaño" style="-fx-text-fill: #888; -fx-font-size: 9px;"/>
                        <Slider fx:id="sliderTamanoLupa" min="50" max="250" value="100" blockIncrement="10" prefWidth="80"
                                style="-fx-cursor: hand;"/>
                        <Label fx:id="lblPorcentajeZoom" text="200%"
                               style="-fx-text-fill: #e50914; -fx-font-size: 10px; -fx-font-weight: bold; -fx-min-width: 30; -fx-alignment: CENTER_RIGHT;"/>
                    </HBox>
                </VBox>
            </children>
        </HBox>

        <ScrollPane fx:id="scrollLector" fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: #1a1a1a; -fx-background-color: #1a1a1a; -fx-border-color: transparent;">
            <content>
                <VBox fx:id="contenedorPaginas" alignment="TOP_CENTER" spacing="8" style="-fx-padding: 0 0 20 0;">
                </VBox>
            </content>
        </ScrollPane>
    </VBox>

    <Pane fx:id="lupaOverlay" visible="false" mouseTransparent="true">
        <children>
            <Circle fx:id="lenteLupa" radius="100" stroke="#e50914" strokeWidth="3" />
        </children>
    </Pane>

    <StackPane fx:id="loadingOverlay" style="-fx-background-color: #1a1a1a;">
        <VBox alignment="CENTER" spacing="15">
            <ProgressIndicator maxWidth="60" maxHeight="60" style="-fx-progress-color: #e50914;" />
            <Label text="Descargando y procesando páginas..."
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
        </VBox>
    </StackPane>

</StackPane>